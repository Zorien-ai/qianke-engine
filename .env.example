# ============================================================================
# 千客引擎 · 环境变量模板
#
# 复制为 .env 后填入你自己的值：
#   cp .env.example .env
#
# 注意：本项目不会隐式读取 .env。请在启动进程前 export 这些变量
# （PowerShell / bash / Docker env_file 均可），否则应用读不到。
# 绝不要把真实的 .env 提交到 Git。
# ============================================================================

# ---------- LLM（必填）----------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 回答生成模型；评测脚本使用独立裁判模型 EVAL_JUDGE_MODEL
DEEPSEEK_MODEL=deepseek-flash

# ---------- 离线评测 ----------
EVAL_JUDGE_MODEL=deepseek-chat
# 提交门禁：全量通过率低于该值则 scripts/run_eval.py 退出码为 1
EVAL_MIN_PASS_RATE=0.85

# ---------- 远程模型服务（云端必填）----------
# 云端 API 不安装 torch/sentence-transformers；设置后 embedding/rerank
# 全部走下面这个 HTTP 服务。留空则回退本地 BGE（仅适合开发机）。
MODEL_API_BASE=
MODEL_API_KEY=
MODEL_API_TIMEOUT=60
MODEL_API_BATCH_SIZE=32
MODEL_API_EMBEDDING_MODEL=bge-m3
MODEL_API_RERANK_MODEL=bge-reranker-v2-m3

# ---------- 身份 / 权限 ----------
RAG_AUTH_ENABLED=1
# 仅本地调试可设为 1：允许 X-Role / X-User 头覆盖身份，生产必须为 0
RAG_ALLOW_HEADER_AUTH=0
RAG_ADMIN_USER=admin
# 本地演示默认密码；首次启动前务必改掉。
# 注意：初始化后再改这里不会改已写入数据库的管理员密码。
RAG_ADMIN_PASSWORD=admin123
RAG_PERMISSIONS_PATH=var/permissions.json
RAG_ANSWER_GUARD=1

# ---------- 图片存储（阿里云 OSS，私有桶）----------
# 三个必填项缺任意一个 → 图片功能整体关闭，文档照常入库，只是不传图。
# 凭证请用 RAM 子账号（最小权限：目标前缀的 PutObject/GetObject），不要用主账号 AK。
# 桶权限保持 private，读图靠签名 URL（有效期见 RAG_OSS_SIGN_EXPIRE）。
RAG_OSS_BUCKET=
RAG_OSS_ACCESS_KEY_ID=
RAG_OSS_ACCESS_KEY_SECRET=
RAG_OSS_REGION=cn-hangzhou
RAG_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
RAG_OSS_PREFIX=kb/
# 签名 URL 有效期（秒），默认 30 分钟；缓存里只存 key，每次响应现签，改动即时生效
RAG_OSS_SIGN_EXPIRE=1800

# ---------- 父块回填粒度 ----------
# section（默认，按标题章节回填）/ doc（整篇全文）/ off（只用命中的 chunk）
RAG_WIKI_PARENT_MODE=section

# ---------- 认证库（PostgreSQL）----------
# 默认与 docker-compose.yml 中的 PostgreSQL 实例一致。
# 等价连接串示例（应用按下面的 PG_* 变量拼装，不直接读取 DATABASE_URL）：
# postgresql://postgres:123456@localhost:5432/vec_db
RAG_AUTH_PG_HOST=localhost
RAG_AUTH_PG_PORT=5432
RAG_AUTH_PG_USER=postgres
# 本地演示默认值；生产必须改，并同步修改 docker-compose.yml 中的 POSTGRES_PASSWORD
RAG_AUTH_PG_PASSWORD=123456
RAG_AUTH_PG_DB=rag_auth

# ---------- Text2SQL 只读账号 ----------
# 应用会自动创建/授权该账号；生产请改成强密码
RAG_SQL_READONLY_USER=sql_reader
RAG_SQL_READONLY_PASSWORD=sql_reader_demo_pwd

# ---------- docker compose（仅 compose 使用）----------
# 默认值与 src/rag_demo/config.py 的本地开发配置保持一致；
# 如修改，必须同时更新 config.py 中的 DB_CONFIG，否则应用连不上。
POSTGRES_USER=postgres
# 本地演示默认值；生产必须改（并同步更新 config.py 的 DB_CONFIG 与 RAG_AUTH_PG_PASSWORD）
POSTGRES_PASSWORD=123456
POSTGRES_DB=vec_db
POSTGRES_PORT=5432

# ---------- LangSmith Tracing ----------
# 可选：填入 LangSmith key（lsv2_pt_ 开头）后重启服务，LangChain/LangGraph 自动上报。
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=qianke-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Agent Runtime ----------
# 请求级等待上限（秒）；超时 API 返回 504
QIANKE_AGENT_WALL_TIMEOUT_SECONDS=70
# LangGraph checkpoint 文件（SQLite）
QIANKE_AGENT_CHECKPOINT_PATH=var/agent_checkpoints.sqlite
