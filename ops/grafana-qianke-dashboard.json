      "title": "Queue Jobs by Status",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 5,
      "targets": [{"expr": "sum by (status) (qianke_work_items)", "legendFormat": "{{status}}", "refId": "A"}],
      "title": "Work Items by Status",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 6,
      "targets": [{"expr": "sum by (status) (qianke_approvals)", "legendFormat": "{{status}}", "refId": "A"}],
