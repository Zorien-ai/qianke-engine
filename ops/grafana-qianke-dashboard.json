{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "textMode": "auto"},
      "targets": [{"expr": "qianke_up", "legendFormat": "up", "refId": "A"}],
      "title": "Qianke Up",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0},
      "id": 2,
      "targets": [{"expr": "qianke_tenants", "legendFormat": "tenants", "refId": "A"}],
      "title": "Tenants",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
      "id": 3,
      "targets": [{"expr": "time() - qianke_process_start_time_seconds", "legendFormat": "uptime", "refId": "A"}],
      "title": "API Uptime",
      "type": "stat"
