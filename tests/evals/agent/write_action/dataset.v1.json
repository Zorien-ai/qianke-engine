      "category": "no_write_intent",
      "scenario": "agent_trajectory",
      "params": {
        "account": "analyst",
        "dataset": "test",
        "request_id": "req_wa_no_intent_01",
        "query": "统计沉默客有多少人",
        "script": [
          {"tool_calls": [{"name": "calculator", "args": {"expression": "2383 + 5727"}}]}
        ],
        "final_answer": "沉默客 2383 人，全量 8110 人。"
      },
      "expect": {
        "query_has_explicit_write_intent": false,
        "status": "COMPLETED",
        "llm_invocations": 2,
        "write_tool_requests": 0,
        "write_tool_results": 0,
        "followup_drafts": 0
      }
    },
    {
