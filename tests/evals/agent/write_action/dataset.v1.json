{
  "version": "agent-write-action-eval-v1",
  "suite": "write_action",
  "title": "B 端受控写 Eval：prepare_followup_task + HITL 确认",
  "description": "确定性评测受控写 Tool 的意图门槛、DRAFT 生成、HITL 确认/取消、角色权限与写入隔离；脚本化 LLM 轨迹，不调用真实模型与网络。",
  "status": "deterministic",
  "baseline": "not_required",
  "dataset": "test",
  "llm": "scripted",
  "network": "none",
  "related_doc": "docs/agent-write-action-eval.md",
  "contract_doc": "docs/agent-write-action.md",
  "tool": "prepare_followup_task",
  "action_type": "followup_task",
  "intent_rule": "runner.has_explicit_write_intent：用户消息出现「创建任务 / 安排跟进 / 记录成待办」等显式写意图标记才算明确要求，否则不应生成 DRAFT",
  "determinism": {
    "llm": "ScriptedLLM 返回固定 AIMessage 轨迹，不接真实模型",
    "storage": "每个 case 使用独立 SQLite：QIANKE_AGENT_ACTION_DB + 重置 actions._DB_PATH",
    "network": "none",
    "clock": "断言不依赖时间；created_at 只做非空/格式契约"
  },
  "accounts": {
    "analyst": {"id": "201", "role": "analyst", "status": "active"},
    "ops": {"id": "202", "role": "ops", "status": "active"},
    "exec": {"id": "203", "role": "exec", "status": "active"},
    "ent_admin": {"id": "204", "role": "analyst", "status": "active", "is_enterprise_admin": true},
    "admin": {"id": "205", "role": "analyst", "status": "active", "is_system_admin": true},
    "cs": {"id": "301", "role": "cs", "status": "active"},
    "guest": {"id": "401", "role": "guest", "status": "active"},
    "demo": {"id": "901", "role": "analyst", "status": "active", "is_demo": true}
  },
  "cases": [
    {
